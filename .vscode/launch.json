{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug game",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/game.exe",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "CMake: build"
    }
  ]
}